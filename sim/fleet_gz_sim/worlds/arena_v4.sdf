<?xml version="1.0"?>
<!-- 생성 파일: python3 -m fleet_gz_sim.arena (arena_v4.yaml) 로 다시 만든다. 손으로 고치지 않는다.
     월드 좌표 = 지도 좌표 = lane_map.yaml 좌표. 레인은 바닥 그림이고 벽·상자는 레인에서
     0.08 m 넘게 떨어져 있다. -->

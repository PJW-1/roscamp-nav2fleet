<?xml version="1.0"?>
<!-- 생성 파일: python3 -m fleet_gz_sim.arena (layout c) 로 다시 만든다.
     손으로 고치지 않는다.
     월드 좌표 = 지도 좌표 = 구역 지도(fleet_map_c.yaml) 좌표. 고정 경로는 바닥 그림이다. -->
<sdf version="1.9">
  <world name="arena">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arena">
      <static>true</static>
      <link name="link">
      <collision name="wall_south"><pose>0.99 -0.025 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_south_visual"><pose>0.99 -0.025 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_north"><pose>0.99 1.015 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_north_visual"><pose>0.99 1.015 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_west"><pose>-0.025 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry></collision>
      <visual name="wall_west_visual"><pose>-0.025 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_east"><pose>2.005 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry></collision>
      <visual name="wall_east_visual"><pose>2.005 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="shelf_1"><pose>0.99 0.3875 0.075 0 0 0</pose><geometry><box><size>0.82 0.015 0.15</size></box></geometry></collision>
      <visual name="shelf_1_visual"><pose>0.99 0.3875 0.075 0 0 0</pose><geometry><box><size>0.82 0.015 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_2"><pose>0.99 0.6025 0.075 0 0 0</pose><geometry><box><size>0.82 0.015 0.15</size></box></geometry></collision>
      <visual name="shelf_2_visual"><pose>0.99 0.6025 0.075 0 0 0</pose><geometry><box><size>0.82 0.015 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <visual name="path_N_W-X_W"><pose>0.44 0.6225 0.0005 0 0 -1.5708</pose><geometry><box><size>0.255 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_S_W-X_W"><pose>0.44 0.3675 0.0005 0 0 1.5708</pose><geometry><box><size>0.255 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_W-W"><pose>0.31 0.495 0.0005 0 0 3.1416</pose><geometry><box><size>0.26 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_N_E-X_E"><pose>1.54 0.6225 0.0005 0 0 -1.5708</pose><geometry><box><size>0.255 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_S_E-X_E"><pose>1.54 0.3675 0.0005 0 0 1.5708</pose><geometry><box><size>0.255 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_E-O"><pose>1.67 0.495 0.0005 0 0 0</pose><geometry><box><size>0.26 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_W-X_E"><pose>0.99 0.495 0.0005 0 0 0</pose><geometry><box><size>1.1 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

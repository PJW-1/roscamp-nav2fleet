<?xml version="1.0"?>
<!-- 생성 파일: python3 -m fleet_gz_sim.arena (layout v7) 로 다시 만든다.
     손으로 고치지 않는다.
     월드 좌표 = 지도 좌표 = 구역 지도(fleet_map_v7.yaml) 좌표. 고정 경로는 바닥 그림이다. -->
<sdf version="1.9">
  <world name="arena">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arena">
      <static>true</static>
      <link name="link">
      <collision name="wall_south"><pose>0.99 -0.025 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_south_visual"><pose>0.99 -0.025 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_north"><pose>0.99 1.015 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_north_visual"><pose>0.99 1.015 0.15 0 0 0</pose><geometry><box><size>2.08 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_west"><pose>-0.025 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry></collision>
      <visual name="wall_west_visual"><pose>-0.025 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_east"><pose>2.005 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry></collision>
      <visual name="wall_east_visual"><pose>2.005 0.495 0.15 0 0 0</pose><geometry><box><size>0.05 0.99 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="shelf_1"><pose>1.12 0.79 0.075 0 0 0</pose><geometry><box><size>0.88 0.04 0.15</size></box></geometry></collision>
      <visual name="shelf_1_visual"><pose>1.12 0.79 0.075 0 0 0</pose><geometry><box><size>0.88 0.04 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_2"><pose>0.835 0.385 0.075 0 0 0</pose><geometry><box><size>0.31 0.04 0.15</size></box></geometry></collision>
      <visual name="shelf_2_visual"><pose>0.835 0.385 0.075 0 0 0</pose><geometry><box><size>0.31 0.04 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_3"><pose>1.405 0.385 0.075 0 0 0</pose><geometry><box><size>0.31 0.04 0.15</size></box></geometry></collision>
      <visual name="shelf_3_visual"><pose>1.405 0.385 0.075 0 0 0</pose><geometry><box><size>0.31 0.04 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_4"><pose>0.25 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry></collision>
      <visual name="shelf_4_visual"><pose>0.25 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_5"><pose>0.51 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry></collision>
      <visual name="shelf_5_visual"><pose>0.51 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <collision name="shelf_6"><pose>0.77 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry></collision>
      <visual name="shelf_6_visual"><pose>0.77 0.05 0.075 0 0 0</pose><geometry><box><size>0.02 0.1 0.15</size></box></geometry><material><ambient>0.27 0.42 0.62 1</ambient><diffuse>0.27 0.42 0.62 1</diffuse></material></visual>
      <visual name="path_Q1-W"><pose>1.88 0.375 0.0005 0 0 1.5708</pose><geometry><box><size>0.24 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_W-X_E"><pose>1.86 0.6775 0.0005 0 0 1.6799</pose><geometry><box><size>0.3672 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_E-O-1"><pose>1.77 0.88 0.0005 0 0 2.8633</pose><geometry><box><size>0.1456 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_E-O-2"><pose>0.9925 0.9 0.0005 0 0 3.1416</pose><geometry><box><size>1.415 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_X_E-N_E"><pose>1.74 0.72 0.0005 0 0 -2.191</pose><geometry><box><size>0.3441 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_N_O-O-1"><pose>0.41 0.76 0.0005 0 0 1.6421</pose><geometry><box><size>0.2807 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="path_N_O-O-2"><pose>0.3425 0.9 0.0005 0 0 3.1416</pose><geometry><box><size>0.115 0.01 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

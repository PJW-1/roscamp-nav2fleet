<?xml version="1.0"?>
<!-- 생성 파일: python3 -m fleet_gz_sim.arena (layout v7) 로 다시 만든다.
     손으로 고치지 않는다.
     월드 좌표 = 지도 좌표 = 구역 지도(fleet_map_v7.yaml) 좌표. 고정 경로는 바닥 그림이다. -->
<sdf version="1.9">
  <world name="arena">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>

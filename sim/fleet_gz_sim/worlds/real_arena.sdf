<?xml version="1.0"?>
<!-- 생성 파일: python3 -m fleet_gz_sim.arena (real_arena.yaml) 로 다시 만든다. 손으로 고치지 않는다.
     월드 좌표 = 지도 좌표 = lane_map.yaml 좌표. 레인은 바닥 그림이고 벽·상자는 레인에서
     0.12 m 넘게 떨어져 있다. -->
<sdf version="1.9">
  <world name="lane_arena">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.85 0.85 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="arena">
      <static>true</static>
      <link name="link">
      <collision name="wall_south"><pose>1.025 -0.025 0.15 0 0 0</pose><geometry><box><size>2.15 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_south_visual"><pose>1.025 -0.025 0.15 0 0 0</pose><geometry><box><size>2.15 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_north"><pose>1.025 1.075 0.15 0 0 0</pose><geometry><box><size>2.15 0.05 0.3</size></box></geometry></collision>
      <visual name="wall_north_visual"><pose>1.025 1.075 0.15 0 0 0</pose><geometry><box><size>2.15 0.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_west"><pose>-0.025 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 1.05 0.3</size></box></geometry></collision>
      <visual name="wall_west_visual"><pose>-0.025 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 1.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="wall_east"><pose>2.075 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 1.05 0.3</size></box></geometry></collision>
      <visual name="wall_east_visual"><pose>2.075 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 1.05 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="bin"><pose>0.6 0.7 0.15 0 0 0</pose><geometry><box><size>0.2 0.2 0.3</size></box></geometry></collision>
      <visual name="bin_visual"><pose>0.6 0.7 0.15 0 0 0</pose><geometry><box><size>0.2 0.2 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="box_small"><pose>1.425 0.725 0.15 0 0 0</pose><geometry><box><size>0.15 0.15 0.3</size></box></geometry></collision>
      <visual name="box_small_visual"><pose>1.425 0.725 0.15 0 0 0</pose><geometry><box><size>0.15 0.15 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="block_long"><pose>1.1 0.35 0.15 0 0 0</pose><geometry><box><size>0.1 0.3 0.3</size></box></geometry></collision>
      <visual name="block_long_visual"><pose>1.1 0.35 0.15 0 0 0</pose><geometry><box><size>0.1 0.3 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="table_2"><pose>1.625 0.375 0.15 0 0 0</pose><geometry><box><size>0.15 0.15 0.3</size></box></geometry></collision>
      <visual name="table_2_visual"><pose>1.625 0.375 0.15 0 0 0</pose><geometry><box><size>0.15 0.15 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <visual name="lane_QW-W"><pose>0.25 0.35 0.0005 0 0 1.5708</pose><geometry><box><size>0.3 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_W-WN"><pose>0.25 0.7125 0.0005 0 0 1.5708</pose><geometry><box><size>0.425 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_WN-QO"><pose>0.725 0.925 0.0005 0 0 0</pose><geometry><box><size>0.95 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_QO-PS"><pose>1.05 0.75 0.0005 0 0 -2.2794</pose><geometry><box><size>0.461 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_PS-PB"><pose>0.85 0.4725 0.0005 0 0 -2.0246</pose><geometry><box><size>0.2281 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_PB-P-3"><pose>0.7 0.41 0.0005 0 0 2.7611</pose><geometry><box><size>0.2154 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_P-3-P-1"><pose>0.7625 0.325 0.0005 0 0 -0.6557</pose><geometry><box><size>0.41 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_PS-P-1"><pose>0.9125 0.3875 0.0005 0 0 -1.5042</pose><geometry><box><size>0.3758 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_P-1-P-2"><pose>0.75 0.175 0.0005 0 0 -2.9997</pose><geometry><box><size>0.3536 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_P-2-QW"><pose>0.4125 0.175 0.0005 0 0 2.9889</pose><geometry><box><size>0.3288 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_QO-EN"><pose>1.5375 0.925 0.0005 0 0 0</pose><geometry><box><size>0.675 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_EN-O"><pose>1.875 0.5875 0.0005 0 0 -1.5708</pose><geometry><box><size>0.675 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

      <collision name="east_post_w"><pose>1.35 0.525 0.15 0 0 0</pose><geometry><box><size>0.1 0.45 0.3</size></box></geometry></collision>
      <visual name="east_post_w_visual"><pose>1.35 0.525 0.15 0 0 0</pose><geometry><box><size>0.1 0.45 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>
      <collision name="east_post_e"><pose>1.725 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 0.45 0.3</size></box></geometry></collision>
      <visual name="east_post_e_visual"><pose>1.725 0.525 0.15 0 0 0</pose><geometry><box><size>0.05 0.45 0.3</size></box></geometry><material><ambient>0.55 0.45 0.35 1</ambient><diffuse>0.55 0.45 0.35 1</diffuse></material></visual>

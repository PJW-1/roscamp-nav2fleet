      <visual name="lane_QO-O"><pose>1.9 0.7125 0.0005 0 0 -1.5708</pose><geometry><box><size>0.375 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_O-OS"><pose>1.9 0.3375 0.0005 0 0 -1.5708</pose><geometry><box><size>0.375 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_OS-B3"><pose>1.725 0.15 0.0005 0 0 3.1416</pose><geometry><box><size>0.35 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_B3-MSE"><pose>1.35 0.15 0.0005 0 0 3.1416</pose><geometry><box><size>0.4 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_MSE-X"><pose>1.0875 0.3375 0.0005 0 0 1.8925</pose><geometry><box><size>0.3953 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_X-MNW"><pose>0.9625 0.7125 0.0005 0 0 1.8925</pose><geometry><box><size>0.3953 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_MNW-T2"><pose>0.7 0.9 0.0005 0 0 3.1416</pose><geometry><box><size>0.4 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_T2-QW"><pose>0.325 0.9 0.0005 0 0 3.1416</pose><geometry><box><size>0.35 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_B1-P-1"><pose>0.5 0.265 0.0005 0 0 1.5708</pose><geometry><box><size>0.23 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>
      <visual name="lane_T2-P-2"><pose>0.5 0.785 0.0005 0 0 -1.5708</pose><geometry><box><size>0.23 0.02 0.001</size></box></geometry><material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material></visual>

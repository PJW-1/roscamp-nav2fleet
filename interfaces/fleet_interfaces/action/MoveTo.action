string target_id
geometry_msgs/Pose2D target_pose
# 레인 폴리라인. 첫 점은 로봇이 있는 곳, 끝 점은 target_pose. 비면 target_pose로 간다
geometry_msgs/Pose[] path
# 제안(팀 합의 전, 계약 0.8): path 끝이 임무의 마지막 지점인가. 거짓이면 잠금 경계라 그 끝에서
# 정밀 접근 대신 설 수 있는 속도로만 줄인다. 끝을 넘지는 않는다
bool final_goal true
# 제안(팀 합의 전, 계약 0.11): 가는 방식. 비면 follow_path다.
# follow_path: path(비면 지금 자리에서 곧게)를 Nav2 FollowPath로 따른다(0.9까지와 같다).
# nav_goal: target_pose로 Nav2 NavigateToPose를 보내고 로봇이 길을 짠다. path는 쓰지 않고(관제는
# 비워 보낸다) final_goal도 뜻이 없다.
string MODE_FOLLOW_PATH="follow_path"
string MODE_NAV_GOAL="nav_goal"
string mode
---
string REASON_NAV_ABORTED="NAV_ABORTED"
string REASON_CANCELED="CANCELED"
string REASON_TIMEOUT="TIMEOUT"
string REASON_HEARTBEAT_LOST="HEARTBEAT_LOST"
# 제안(팀 합의 전): path가 로봇의 지금 위치를 지나지 않아 따라가지 않았다(R20)
string REASON_PATH_NOT_CONNECTED="PATH_NOT_CONNECTED"

bool success
string reason
---
float32 distance_remaining

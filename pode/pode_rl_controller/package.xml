<?xml version="1.0"?>
<package format="3">
  <name>pode_rl_controller</name>
  <version>0.1.0</version>
  <description>Nav2 controller plugin FollowPathRL: runs an RL driving policy (ONNX, ONNX Runtime) on the observation of learning/goal_reach/task_spec.py</description>
  <maintainer email="team@example.com">team-2</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_util</depend>
  <depend>nav_msgs</depend>
  <depend>onnxruntime_vendor</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>yaml_cpp_vendor</depend>
  <exec_depend>pode_nav_config</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/follow_path_rl.xml"/>
  </export>
</package>

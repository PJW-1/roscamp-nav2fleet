<?xml version="1.0"?>
<package format="3">
  <name>pode_plan_keep</name>
  <version>0.1.0</version>
  <description>Pode plan keep: sits between the Nav2 goal tree and the planner and keeps the current route when a replan only finds another way of about the same length</description>
  <maintainer email="team@example.com">team-2</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
